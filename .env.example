# Copy this file to .env and fill in the blanks. .env is git-ignored and must
# never be committed - it holds a live Azure SQL credential.

# Azure SQL server hosting Keycloak's own store.
SQL_SERVER_FQDN=soccerteambuilder.database.windows.net
SQL_DATABASE=keycloak
SQL_USERNAME=
SQL_PASSWORD=

# Bootstrap admin for the Keycloak admin console at http://localhost:8080.
# Created on first start only; pick a real password, not 'admin'.
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=
